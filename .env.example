# Copie para .env e preencha. O .env nunca vai para o git.

# SteamID64 do perfil (a wishlist exige "Detalhes de jogos" público na privacidade da Steam)
STEAM_ID=76561198059563647

# Região dos preços (BR = reais)
COUNTRY=BR

# Chave gratuita do IsThereAnyDeal (menor preço histórico). Opcional no spike.
# Crie em https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Discord: bot que envia os alertas por DM (Developer Portal > seu app > Bot > Redefinir token)
DISCORD_BOT_TOKEN=
# Seu ID de usuário (Modo desenvolvedor > botão direito no seu nome > Copiar ID do usuário)
DISCORD_USER_ID=

# Opcional: appids separados por vírgula, usados se a wishlist não puder ser lida
APPIDS=

# De quantas em quantas horas verificar os preços, de 1 a 24 (2)
INTERVALO_HORAS=

# --- Regras do alerta (vazio = valor padrão entre parênteses) ---
# Até quantos % acima do menor histórico ainda é 🟡 "perto do menor" (10)
MARGEM_PERTO_PCT=
# Desconto mínimo para alertar, mesmo sendo 🟢/🟡. 0 = o selo decide sozinho (0)
DESCONTO_MIN_PCT=
# Nota mínima de reviews em % positivas. 0 = sem filtro; jogo sem análises sempre passa (0)
REVIEW_MIN_PCT=
# Menor preço de referência: steam | qualquer (steam)
REFERENCIA=
# Jogo sem histórico no ITAD só alerta com desconto a partir deste % (50)
SEM_HISTORICO_MIN_PCT=
